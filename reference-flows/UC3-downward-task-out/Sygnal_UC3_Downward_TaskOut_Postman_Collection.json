  "item": [
    {
      "name": "Task-out Coordination  (BAP ComEMR → BPP DIGIT HCM)",
      "description": "Downward matched task-out over the generic ServiceCoordination contract.",
      "item": [
        {
          "name": "01 — discover",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "description": "Network-issued JWT."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"domain\": \"{{domain}}\",\n    \"networkId\": \"{{network_id}}\",\n    \"action\": \"discover\",\n    \"version\": \"2.0.0\",\n    \"bapId\": \"{{comemr_np_id}}\",\n    \"bapUri\": \"{{bap_uri}}\",\n    \"transactionId\": \"{{transaction_id_uc3}}\",\n    \"messageId\": \"7dbb0b4c-248d-5933-829f-40e736fa8eae\",\n    \"timestamp\": \"2026-07-06T14:50:00+03:00\",\n    \"schemaContext\": [\n      \"https://schema.beckn.io/ServiceCoordinationResource/v2.1/context.jsonld\",\n      \"https://schema.beckn.io/ServiceCoordinationOffer/v2.1/context.jsonld\"\n    ]\n  },\n  \"message\": {\n    \"intent\": {\n      \"textSearch\": \"campaign field capacity net distribution catchment DEMO-01\",\n      \"filters\": {\n        \"type\": \"jsonpath\",\n        \"expression\": \"$.catalogs[*].resources[*] ? (@.resourceAttributes.acceptanceMode == \\\"MANUAL_REVIEW\\\")\"\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{bpp_uri}}/discover"
            },
            "description": "ComEMR discovers campaigns with field reach in the catchment (matched transaction). Broadcast — no bppId; schemaContext present."
          },
          "response": []
        },
        {
          "name": "02 — on_discover",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}",
                "description": "Network-issued JWT."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"domain\": \"{{domain}}\",\n    \"networkId\": \"{{network_id}}\",\n    \"action\": \"on_discover\",\n    \"version\": \"2.0.0\",\n    \"bapId\": \"{{comemr_np_id}}\",\n    \"bapUri\": \"{{bap_uri}}\",\n    \"transactionId\": \"{{transaction_id_uc3}}\",\n    \"messageId\": \"f6d4f74d-300b-5fce-bb8d-010d4a428e8f\",\n    \"timestamp\": \"2026-07-06T14:51:00+03:00\",\n    \"bppId\": \"{{hcm_np_id}}\",\n    \"bppUri\": \"{{bpp_uri}}\",\n    \"schemaContext\": [\n      \"https://schema.beckn.io/ServiceCoordinationResource/v2.1/context.jsonld\",\n      \"https://schema.beckn.io/ServiceCoordinationOffer/v2.1/context.jsonld\"\n    ]\n  },\n  \"message\": {\n    \"catalogs\": [\n      {\n        \"id\": \"{{campaign_catalog_id}}\",\n        \"bppId\": \"{{hcm_np_id}}\",\n        \"bppUri\": \"{{bpp_uri}}\",\n        \"descriptor\": {\n          \"name\": \"DIGIT HCM — Campaign Field Capacity\"\n        },\n        \"provider\": {\n          \"id\": \"{{chw_campaign_participant_id}}\",\n          \"descriptor\": {\n            \"name\": \"ITN Campaign — Catchment DEMO-01\"\n          }\n        },\n        \"resources\": [\n          {\n            \"id\": \"{{campaign_resource_id}}\",\n            \"descriptor\": {\n              \"name\": \"Campaign Field Capacity\",\n              \"shortDesc\": \"Care-coordination desk\",\n              \"longDesc\": \"Standing coordination capability: routes referrals to clinical CHW / PHU, manages lifecycle and handover.\"\n            },\n            \"resourceAttributes\": {\n              \"@context\": \"https://schema.beckn.io/ServiceCoordinationResource/v2.1/context.jsonld\",\n              \"@type\": \"scres:ServiceCoordinationResource\",\n              \"coordinationScope\": {\n                \"referralCategories\": [\n                  {\n                    \"@context\": \"{{codedvalue_ctx}}\",\n                    \"@type\": \"ReferralCategory\",\n                    \"code\": \"OPERATIONAL\",\n                    \"display\": \"Operational\"\n                  }\n                ],\n                \"targetServiceTypes\": [\n                  {\n                    \"@context\": \"{{codedvalue_ctx}}\",\n                    \"@type\": \"TargetServiceType\",\n                    \"code\": \"FIELD_VISIT\",\n                    \"display\": \"Field_Visit\"\n                  }\n                ],\n                \"geographyScope\": [\n                  {\n                    \"@context\": \"{{codedvalue_ctx}}\",\n                    \"@type\": \"LGDDistrict\",\n                    \"code\": \"DEMO-01\",\n                    \"display\": \"Campaign District\"\n                  }\n                ]\n              },\n              \"acceptanceMode\": \"MANUAL_REVIEW\",\n              \"supportedUrgencyTiers\": [\n                \"ROUTINE\",\n                \"URGENT\",\n                \"EMERGENCY\"\n              ]\n            }\n          }\n        ],\n        \"offers\": [\n          {\n            \"id\": \"{{campaign_offer_id}}\",\n            \"resourceIds\": [\n              \"{{campaign_resource_id}}\"\n            ],\n            \"descriptor\": {\n              \"name\": \"Field task engagement\",\n              \"shortDesc\": \"Campaign-mode CHW field checks / data collection\"\n            },\n            \"offerAttributes\": {\n              \"@context\": \"https://schema.beckn.io/ServiceCoordinationOffer/v2.1/context.jsonld\",\n              \"@type\": \"scoff:ServiceCoordinationOffer\",\n              \"coverageWindow\": {\n                \"start\": \"2026-07-01\",\n                \"end\": \"2026-07-31\"\n              }\n            }\n          }\n        ]\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{bap_uri}}/on_discover"
            },
            "description": "HCM returns its campaign field-capacity offer (generic ServiceCoordinationResource / ServiceCoordinationOffer)."
          },
          "response": []
        },
