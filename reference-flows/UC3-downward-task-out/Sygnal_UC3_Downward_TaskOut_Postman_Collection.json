            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"domain\": \"{{domain}}\",\n    \"networkId\": \"{{network_id}}\",\n    \"action\": \"select\",\n    \"version\": \"2.0.0\",\n    \"bapId\": \"{{comemr_np_id}}\",\n    \"bapUri\": \"{{bap_uri}}\",\n    \"transactionId\": \"{{transaction_id_uc3}}\",\n    \"messageId\": \"699de8ea-a495-5120-9631-7f91c641f60c\",\n    \"timestamp\": \"2026-07-06T15:00:00+03:00\",\n    \"bppId\": \"{{hcm_np_id}}\",\n    \"bppUri\": \"{{bpp_uri}}\"\n  },\n  \"message\": {\n    \"contract\": {\n      \"status\": {\n        \"code\": \"DRAFT\"\n      },\n      \"commitments\": [\n        {\n          \"id\": \"commitment-001\",\n          \"status\": {\n            \"descriptor\": {\n              \"code\": \"DRAFT\"\n            }\n          },\n          \"resources\": [\n            {\n              \"id\": \"{{campaign_resource_id}}\",\n              \"quantity\": {\n                \"count\": 1\n              }\n            }\n          ],\n          \"offer\": {\n            \"id\": \"{{campaign_offer_id}}\",\n            \"resourceIds\": [\n              \"{{campaign_resource_id}}\"\n            ]\n          }\n        }\n      ],\n      \"participants\": [\n        {\n          \"id\": \"{{comemr_coordinator_participant_id}}\",\n          \"participantAttributes\": {\n            \"@context\": \"https://schema.beckn.io/ServiceParticipant/v2.1/context.jsonld\",\n            \"@type\": \"spa:ServiceParticipant\",\n            \"participantRole\": \"REQUESTER\"\n          }\n        },\n        {\n          \"id\": \"{{chw_campaign_participant_id}}\",\n          \"participantAttributes\": {\n            \"@context\": \"https://schema.beckn.io/ServiceParticipant/v2.1/context.jsonld\",\n            \"@type\": \"spa:ServiceParticipant\",\n            \"participantRole\": \"FIELD_WORKER\"\n          }\n        }\n      ],\n      \"contractAttributes\": {\n        \"@context\": \"https://schema.beckn.io/ServiceCoordination/v2.1/context.jsonld\",\n        \"@type\": \"scoord:ServiceCoordination\",\n        \"coordinationId\": \"{{coordination_id_uc3}}\",\n        \"lifecycleState\": \"DRAFT\",\n        \"targetCriteria\": {\n          \"serviceCategory\": {\n            \"@context\": \"{{codedvalue_ctx}}\",\n            \"@type\": \"ServiceCategory\",\n            \"code\": \"FIELD_DATA_COLLECTION\",\n            \"display\": \"Field data collection\"\n          },\n          \"urgencyTier\": \"ROUTINE\",\n          \"modality\": \"IN_PERSON\"\n        }\n      }\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{bpp_uri}}/select"
            },
            "description": "ComEMR selects the campaign to perform field checks / data collection. Generic ServiceCoordination contract; serviceCategory FIELD_DATA_COLLECTION (self-authored CodedValue)."
          },
          "response": []
